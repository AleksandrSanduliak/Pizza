{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["src/1-app/*"],
      "@pages/*": ["src/2-pages/*"],
      "@features/*": ["src/3-features/*"],
      "@entities/*": ["src/4-entities/*"],
      "@shared/*": ["src/5-shared/*"]
    }
  },
  "include": ["src"]
}
